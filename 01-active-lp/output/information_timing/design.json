    "objective": "Minimize equal-regime mean private-information advantage on train only.",
    "participation_constraints": "For every train regime where flat public entry has strictly positive expected net profit, preserve strictly positive public entry profit. Preserve at least half of flat private entry rate averaged across train regimes. These are explicit normative safeguards, not a welfare theorem."
  },
  "mc_replication": {
    "draws_per_seed": 20000,
    "pairing": "Identical world draws for every policy and residual rule in a regime.",
    "purpose": "Independent Monte Carlo check against exactly enumerated synthetic expectations, not additional real-world validation.",
